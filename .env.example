# --- MongoDB Atlas (required for the real Track 3 path) ---
# Leave MONGODB_URI empty to run against a local throwaway mongod (mongodb-memory-server).
# Local mode has NO Atlas Vector Search; OpsRelay will label vector results UNVERIFIED.
MONGODB_URI=
MONGODB_DB=opsrelay

# --- OpenAI (embeddings + decision explanation) ---
# Without a key, OpsRelay uses a labeled hashed-embedding fallback and a template explanation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: read-only GitHub org discovery (repo catalog only; never mutates GitHub) ---
GITHUB_ORG=
GITHUB_TOKEN=

# --- Local ports (defaults shown) ---
# APP_URL=http://localhost:3000
# SANDBOX_URL=http://localhost:4010

# --- Optional plugins (see /plugins) ---
# Slack: incoming webhook for the on-call channel
SLACK_WEBHOOK_URL=
# Atlassian Jira Cloud: one issue per incident + stage comments
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
